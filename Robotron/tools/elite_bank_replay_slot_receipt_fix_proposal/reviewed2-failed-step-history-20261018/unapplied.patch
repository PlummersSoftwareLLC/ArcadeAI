+    def _invalidate_ring_receipts_locked(self):
+        """New process-local occupancy identity; caller owns lock/publication."""
+        self._ring_receipt_epoch = object()
+        self._ring_receipt_serial = 0
+        self._ring_receipt_origin = int(self.tree.data_ptr)
+
+    def _indices_from_receipts_locked(self, serials, receipt_context):
+        """Resolve ALL serials atomically or refuse; never infer a lost token.
+
+        Context is (opaque epoch, complete flag). These are process-local
+        ingestion receipts, unrelated to exposure or persisted bank epochs.
+        Caller holds the SAME lock through subsequent row copy/mutation.
+        """
+        if (type(receipt_context) is not tuple or len(receipt_context) != 2
+                or receipt_context[0] is not self._ring_receipt_epoch
+                or receipt_context[1] is not True):
+            return None
+        current = self._ring_receipt_serial
+        if (type(current) is not int or current < 0 or self.capacity <= 0
+                or self.tree.capacity != self.capacity or self.size != self.tree.size
+                or not 0 <= self.size <= self.capacity
+                or not 0 <= self.tree.data_ptr < self.capacity
+                or not 0 <= self._ring_receipt_origin < self.capacity):
+            return None
+        if self.tree.data_ptr != (self._ring_receipt_origin + current) % self.capacity:
+            return None
+        serials = list(serials)
+        if any(type(s) is not int or s <= 0 or not 0 <= current - s < self.capacity for s in serials):
+            return None
+        indices = np.asarray([(self._ring_receipt_origin + s - 1) % self.capacity for s in serials], dtype=np.int64)
+        if np.any(indices >= self.size):
+            return None
+        return indices
