        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "identity"
      ],
      "type": "object"
