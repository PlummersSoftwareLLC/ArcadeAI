        },
        "identity": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "ctime_ns": {
              "minimum": 0,
              "type": "integer"
            },
            "device": {
              "minimum": 0,
              "type": "integer"
            },
            "inode": {
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "pattern": "^0o[0-7]+$",
