            },
            "mtime_ns": {
              "minimum": 0,
              "type": "integer"
            },
            "nlink": {
              "minimum": 0,
              "type": "integer"
            },
            "uid": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "device",
            "inode",
            "bytes",
            "mtime_ns",
            "ctime_ns",
            "mode",
            "uid",
            "nlink"
          ],
          "type": "object"
        },
        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
