+        spec=dict(initial=tool.fingerprint(path),parsed_values=values,policy="same_bytes_after_owned_stop_only")
+        state=tool.SettingsLifecycle(spec,str(root));retired=dict(pid=10,starttime_ticks=1010)
+        return root,path,spec,state,retired
+
+    def replace(self,path,raw,mode=0o664):
+        temporary=path.with_name("game_settings.json.tmp")
+        temporary.write_bytes(raw);temporary.chmod(mode);os.replace(temporary,path)
+
+    def test_atomic_same_byte_shutdown_rewrite_requires_owned_absence_and_durable_receipt(self):
+        root,path,spec,state,retired=self.fixture();raw=path.read_bytes()
+        self.replace(path,raw)
+        with self.assertRaises(RuntimeError):state.check()
+        with self.assertRaisesRegex(RuntimeError,"still live"):
+            state.adopt_after_stop(retired,"before",lambda:(_ for _ in ()).throw(RuntimeError("still live")),lambda _:None)
+        self.assertEqual(state.current,spec["initial"])
+        receipt=state.adopt_after_stop(retired,"before",lambda:None,lambda value:tool.publish(root/"settings-transition.json",value))
+        proof=tool.read_json(receipt)
+        self.assertEqual(proof["replacement"]["sha256"],spec["initial"]["sha256"])
+        self.assertNotEqual(proof["replacement"]["identity"]["inode"],spec["initial"]["identity"]["inode"])
+        self.assertEqual(proof["parsed_values"],spec["parsed_values"])
