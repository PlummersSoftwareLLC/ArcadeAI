+    def stop_owned(self, expected=None):
+        retired = self.trainer_id()
+        # Register the exact candidate before requesting stop. If interruption
+        # lands after stop completes but before this caller returns, recovery
+        # can confirm its absence; a PID observed later is never adopted.
+        with self.metrics.block_restore_signals():
+            self.retirement_candidate = copy.deepcopy(retired)
+        self.host.stop(expected)
+        self.confirm_retired()
+        return retired
+
+    def confirm_retired(self):
+        retired = self.retirement_candidate
+        require(retired is not None, "No explicitly registered owned stop")
+        key = SettingsLifecycle.key(retired)
+        if key not in self.settings.transitions:
+            known = self.host.known_trainer
+            require(known is not None and retired["pid"] == known["pid"]
+                and retired["starttime_ticks"] == known["identity"]["starttime_ticks"]
+                and retired["unit"] == self.job["trainer_unit"] and retired["cgroup"] == known["cgroup"]
+                and known["identity"] in self.host.retired_trainers, "Stop candidate is not a known explicitly stopped trainer")
+        self.absence()
+        # This retirement does NOT mean a checkpoint passed verification. Keep
+        # the owner before the first post-stop file check or publication.
+        self.retired_owner = copy.deepcopy(retired)
+        with self.metrics.block_restore_signals():
+            receipt = self.settings.adopt_after_stop(retired, self.phase, self.absence,
+                lambda value:publish(self.output / ("settings-after-stop-"+key+".json"), value))
+        return retired,receipt
