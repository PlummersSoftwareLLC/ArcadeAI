+class SettingsLifecycle:
+    """One precommitted state file may be replaced only by a confirmed stop.
+
+    The held content/values/mode/owner/link policy never changes. Each registered
+    retirement may authorize at most one durable full-identity transition.
+    Repeated verification cannot adopt a later unknown writer's replacement.
+    """
+    def __init__(self, specification, model_dir):
+        require(isinstance(specification, dict) and set(specification) == {"initial", "parsed_values", "policy"}
+            and specification["policy"] == "same_bytes_after_owned_stop_only", "Invalid settings lifecycle precommit")
+        self.initial = copy.deepcopy(specification["initial"])
+        self.current = copy.deepcopy(self.initial)
+        self.values = copy.deepcopy(specification["parsed_values"])
+        require(self.initial["path"] == str(Path(model_dir) / "game_settings.json"), "Wrong settings lifecycle path")
+        expected = {"start_advanced": False, "start_level_min": 1, "epsilon_pct": -1,
+            "expert_pct": -1, "auto_curriculum": False, "difficulty": 5}
+        actual_values = read_json(self.initial)
+        require(self.values == expected and all(type(self.values[key]) is type(value) for key,value in expected.items())
+            and actual_values == self.values and all(type(actual_values[key]) is type(value) for key,value in expected.items()),
+            "Initial full settings identity/content/parsed values differ")
+        info = self.initial["identity"]
+        require(info["uid"] == os.getuid() and info["nlink"] == 1 and int(info["mode"],8) in (0o644,0o664),
+            "Settings must initially be owned regular single-link with held writable mode")
+        self.transitions = {}
+
+    @staticmethod
+    def key(retired):
+        return "%s-%s" % (retired["pid"],retired["starttime_ticks"])
+
+    def check(self):
+        pin(self.current, MAX_JSON)
+
+    def adopt_after_stop(self, retired, source_phase, confirm_owned_absence, publish_receipt):
+        require(source_phase in ("before","after"), "Unknown source phase for settings transition")
+        confirm_owned_absence()
+        key = self.key(retired)
+        if key in self.transitions:
+            self.check()
+            return self.transitions[key]
+        candidate = fingerprint(self.initial["path"], MAX_JSON)
+        require(candidate["sha256"] == self.initial["sha256"] and candidate["bytes"] == self.initial["bytes"]
+            and all(candidate["identity"][name] == self.initial["identity"][name] for name in ("device","mode","uid","nlink"))
+            and read_json(candidate) == self.values, "Stopped settings replacement changed held bytes/values/mode/owner/link policy")
+        confirm_owned_absence()
+        pin(candidate, MAX_JSON)
+        receipt = publish_receipt(dict(schema="robotron-live8-owned-stop-settings-transition-v1", retired_trainer=retired,
+            source_phase=source_phase, original=self.initial, previous=self.current, replacement=candidate,
+            parsed_values=self.values, allowed_change="Full identity only after known owned stop; bytes/SHA/values/device/mode/uid/nlink unchanged"))
+        # Publication must succeed before a replacement identity is trusted by
+        # any later static guard, checkpoint verification or trainer start.
+        self.current = candidate
+        self.transitions[key] = receipt
+        return receipt
+
