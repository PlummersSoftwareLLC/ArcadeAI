+def held_boot_paths(environment, game_root, model_dir, source_hashes):
+    """Resolve only the pinned held config's explicit path or exact default.
+
+    config.py strips the env value and defaults to its Robotron/models_dqn.
+    No environment is changed and no path/config module is imported here.
+    """
+    config_path = str(Path(game_root) / "Scripts/dqn/config.py")
+    require(source_hashes.get(config_path) == BOOT_CONFIG_SHA256, "Boot default requires exact held config source")
+    explicit = (environment.get("ROBOTRON_DQN_MODEL_DIR") or "").strip()
+    resolved = explicit or str(Path(game_root) / "models_dqn")
+    require(resolved == model_dir and Path(resolved).is_absolute(), "Explicit/default model directory differs from held root job")
+    latest = str(Path(model_dir) / "robotron_dqn_latest.pt")
+    require(environment.get("DQN_RATCHET") == "0" and environment.get("DQN_EXACT_GRAPH_CHECKPOINT") == latest,
+        "Held boot must use latest with ratchet disabled and matching exact-graph checkpoint")
+    return dict(model_dir=resolved, latest=latest, path_source="explicit_environment" if explicit else "pinned_config_default",
+        config_path=config_path, config_sha256=BOOT_CONFIG_SHA256)
+
