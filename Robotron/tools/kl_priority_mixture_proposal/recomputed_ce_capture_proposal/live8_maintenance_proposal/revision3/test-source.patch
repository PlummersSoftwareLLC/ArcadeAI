+    def test_successful_venv_symlink_argv_is_preserved_without_executing_it(self):
+        _,verifier,insurance=self.fixture()
+        before=copy.deepcopy(verifier)
+        proof=tool.validate_python_binding(verifier,insurance,hash_executable=True)
+        self.assertEqual(proof["argv_path"],verifier["python"])
+        self.assertNotEqual(proof["argv_path"],proof["resolved_executable"])
+        self.assertTrue(proof["venv_preserved"])
+        self.assertEqual(verifier,before)
