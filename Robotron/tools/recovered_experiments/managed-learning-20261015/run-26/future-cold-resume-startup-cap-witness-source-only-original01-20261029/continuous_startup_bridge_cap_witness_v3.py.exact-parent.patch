+def startup_budget_witness(agent, metrics, cfg, expected_cap):
+    """Read-only cold-start check; caller holds original training/memory locks.
+
+    load() already creates the fresh per-boot baseline. Never install/rebase an
+    anchor, change config, reset a clock, or wait for a producer under memory.lock.
+    """
+    require(type(expected_cap) is int and expected_cap in (8, 12), 'Root startup cap must be explicit8 or12')
+    entries = [part.split('=', 1) for part in Path('/proc/self/environ').read_bytes().decode().split('\0') if '=' in part]
+    caps = [value for key, value in entries if key == 'DQN_MAX_SAMPLES_PER_FRAME']
+    require(caps == [str(expected_cap)]
+            and os.environ.get('DQN_MAX_SAMPLES_PER_FRAME') == str(expected_cap)
+            and float(cfg.max_samples_per_frame) == float(expected_cap),
+            'Original process startup environment and runtime cap differ from Root selection')
+    with metrics.lock:
+        loaded = dict(frame_count=int(metrics.loaded_frame_count),
+            measurement_frame_count=int(metrics.loaded_measurement_frame_count),
+            optimized_samples=int(metrics.loaded_optimized_samples))
+        current = dict(frame_count=int(metrics.frame_count),
+            measurement_frame_count=int(metrics.measurement_frame_count),
+            optimized_samples=int(agent.optimized_samples))
+        local = getattr(agent, '_replay_pressure_anchor', None)
+        warmup = getattr(agent, '_replay_warmup_pending', False)
+        require(loaded == current and agent.loaded_optimized_samples == loaded['optimized_samples']
+                and (local is None or tuple(local) == tuple(loaded.values()))
+                and warmup is False, 'Restored fresh budget baseline or warmup state differs')
+    require(len(agent.memory) >= max(int(cfg.batch_size), int(cfg.min_replay_to_train)),
+            'Ready restored replay is required; no later warmup rebase may be assumed')
+    return dict(schema='robotron-cold-start-existing-budget-witness-v1', expected_startup_cap=expected_cap,
+        process_startup_environment_cap=caps[0], runtime_cap=float(cfg.max_samples_per_frame),
+        loaded_baseline=loaded, observed_existing_local_anchor=None if local is None else list(local),
+        replay_warmup_pending=False, samples_since_loaded=0, unmeasured_frames_since_loaded=0,
+        fresh_per_boot_baseline_verified=True, anchor_installed_or_rebased=False,
+        model_optimizer_scaler_replay_or_lifetime_clock_changed=False)
 
 
