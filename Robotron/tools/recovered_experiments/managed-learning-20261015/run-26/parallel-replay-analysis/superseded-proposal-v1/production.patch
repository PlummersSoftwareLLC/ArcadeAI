+def _drain_state_futures(futures):
+    """Delay interruption until every submitted destination writer is done."""
+    interrupted = None
+    while any(not future.done() for future in futures):
+        try:
+            wait(futures)
+        except BaseException as error:
+            if interrupted is None:
+                interrupted = error
+    if interrupted is not None:
+        raise interrupted
 
 
