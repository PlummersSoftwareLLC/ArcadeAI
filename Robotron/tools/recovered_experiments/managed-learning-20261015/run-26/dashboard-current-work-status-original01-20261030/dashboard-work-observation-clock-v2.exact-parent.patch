+def semantic_observation_time(control, now):
+    """Manual phase freshness belongs to its observation, not this writer poll."""
+    stamp = control.get("observation_unix_s")
+    if stamp is None:
+        stamp = control["next_work"].get("updated_unix_s")
+    if type(stamp) not in (int, float) or not 0 < stamp <= now:
+        raise ValueError("Manual work status needs an actual finite nonfuture observation time")
+    return stamp
+
