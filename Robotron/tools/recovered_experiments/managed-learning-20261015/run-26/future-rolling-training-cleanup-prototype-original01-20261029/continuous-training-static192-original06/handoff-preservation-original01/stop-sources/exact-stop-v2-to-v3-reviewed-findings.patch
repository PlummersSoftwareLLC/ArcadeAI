+                error='StopUnit delivery/completion unknown; observe the same original, never retry',
+                stdout=self.event(kind+'-stop-stdout.txt',error.stdout or b''),
+                stderr=self.event(kind+'-stop-stderr.txt',error.stderr or b'')))
