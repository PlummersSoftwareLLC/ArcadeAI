+def capacity_overlay(family, h):
+    """Authenticate only the declared finite reader-capacity/source-link delta.
+
+    Original readiness remains an original-source proof. No historical sample
+    is relabelled as having run the new collector.
+    """
+    require(family.get('main_journal_capacity_overlay') == CAPACITY_OVERLAY_PACKET,
+            'Explicit selected main-journal capacity authority required')
+    packet = json.loads(h.checked(CAPACITY_OVERLAY_PACKET).read_bytes())
+    require(packet['schema'] == 'robotron-main-journal128-capacity-observer-four-source-preparation-v1'
+            and packet['root_selected_maximum_main_prefix_bytes'] == 128 << 20,
+            'Exact finite128MiB main-journal source extension required')
+    mapping = json.loads(h.checked(packet['observer_source_map']).read_bytes())
+    parent = json.loads(h.checked(packet['parent_source_map']).read_bytes())
+    h.checked(packet['derivation'])
+    require(mapping['parent_source_map'] == packet['parent_source_map']
+            and mapping['capacity_derivation'] == packet['derivation']
+            and mapping['observer_sources'] == family['main_observer']
+            and mapping['observer_reviewer'] == family['round_observer_reviewer']
+            and family.get('main_domain_readiness_reviewer') == packet['parents']['observer_reviewer']
+            and mapping['main_journal_capacity_overlay'] == dict(
+                schema='robotron-main-game-journal-capacity-overlay-v1',parent_bytes=16 << 20,
+                maximum_prefix_bytes=128 << 20,original_case_and_inventory_unchanged=True,
+                all_remaining_limits_and_predicates_unchanged=True),
+            'Selected capacity map/readiness source identity differs')
+    for value in [*parent['observer_sources'].values(),*mapping['observer_sources'].values(),
+                  packet['parents']['observer_reviewer'],packet['sources']['observer_reviewer']]:
+        h.checked(value)
+    for key in ('registry','client','durability','control','interpreter'):
+        require(mapping['observer_sources'][key] == parent['observer_sources'][key],
+                'Capacity overlay changed an unrelated observer dependency')
+    replacements = {
+        'health_base': [('read_producer_prefix(main,16<<20)', 'read_producer_prefix(main,128<<20)')],
+        'health': [(Path(packet['parents']['health_base']['path']).name,Path(packet['sources']['health_base']['path']).name),
+                   (packet['parents']['health_base']['sha256'],packet['sources']['health_base']['sha256']),
+                   ('_prospective_current_eval_quiescence_health_v5','_prospective_current_eval_quiescence_main_journal128_health_v1')],
+        'worker': [(packet['parents'][key]['path'],packet['sources'][key]['path']) for key in ('health_base','health')],
+        'observer_reviewer': [(packet['parents'][key]['path'],packet['sources'][key]['path']) for key in ('health_base','health')],
+    }
+    for role, edits in replacements.items():
+        original = h.checked(packet['parents'][role]).read_text()
+        for before, after in edits:
+            require(original.count(before) == 1, 'Capacity delta parent literal is ambiguous: '+role)
+            original = original.replace(before,after,1)
+        require(h.checked(packet['sources'][role]).read_text() == original,
+                'Only the exact reader bound and dependency-link edits are authorized: '+role)
+    return parent['observer_sources'], packet['parents']['observer_reviewer']
