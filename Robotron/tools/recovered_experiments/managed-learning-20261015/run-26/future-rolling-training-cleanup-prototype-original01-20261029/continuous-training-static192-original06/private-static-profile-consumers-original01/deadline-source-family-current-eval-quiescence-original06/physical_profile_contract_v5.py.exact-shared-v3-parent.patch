+def normalize_capture_fullpin(value):
+    """Normalize only the capture writer's integer permission representation.
+
+    Full identity/SHA fields are preserved. This never refreshes an identity or
+    reads a file. The result is compatible with the ordinary full8 verifier.
+    """
+    require(type(value) is dict and set(value) == {'path','sha256','bytes','identity'}
+            and type(value['identity']) is dict
+            and set(value['identity']) == {'device','inode','bytes','mtime_ns','ctime_ns','mode','uid','nlink'},
+            'Exact capture full8 source/control pin required')
+    require(all(type(value['identity'][key]) is int and value['identity'][key] >= 0
+                for key in ('device','inode','bytes','mtime_ns','ctime_ns','uid','nlink'))
+            and type(value['path']) is str and value['path'].startswith('/')
+            and '/..' not in value['path'] and '/./' not in value['path'],
+            'Typed unchanged full8 capture identity and absolute source path required')
+    out = json.loads(json.dumps(value,allow_nan=False)); mode = out['identity']['mode']
+    require((type(mode) is int and 0 <= mode <= 0o777)
+            or (type(mode) is str and mode.startswith('0o') and 0 <= int(mode,8) <= 0o777),
+            'Typed capture permissions required')
+    if type(mode) is int:
+        out['identity']['mode'] = oct(mode)
+    require(out['identity']['mode'] == oct(int(out['identity']['mode'],8))
+            and type(out['bytes']) is int and out['bytes'] == out['identity']['bytes']
+            and type(out['sha256']) is str and len(out['sha256']) == 64
+            and all(c in '0123456789abcdef' for c in out['sha256']),
+            'Exact capture byte count and SHA required')
+    return out
+
