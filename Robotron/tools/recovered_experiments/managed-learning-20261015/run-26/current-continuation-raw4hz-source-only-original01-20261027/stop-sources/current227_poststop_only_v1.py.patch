+def release_retired_empty_dashboard(linux, owner, case):
+    """Remove only this case's empty HTTP child after actual exit0."""
+    value = linux.show(owner['unit'])
+    require(linux.process_start(owner['pid']) is None and value.get('MainPID') == '0'
+            and value.get('InvocationID') == owner['invocation_id']
+            and value.get('ExecMainPID') == str(owner['pid']) and value.get('ExecMainCode') == '1'
+            and value.get('ExecMainStatus') == '0' and value.get('NRestarts') == '0',
+            'Only actual retired exit0 permits HTTP child cleanup')
+    child = Path('/sys/fs/cgroup'+owner['cgroup'])/('dashboard-'+case)
+    if not child.exists():
+        return dict(status='retired_HTTP_child_already_absent')
+    require(child.resolve(strict=True) == child and child.stat().st_uid == os.getuid()
+            and (child/'cgroup.type').read_text().strip() == 'threaded'
+            and not (child/'cgroup.threads').read_text().strip()
+            and dict(line.split() for line in (child/'cgroup.events').read_text().splitlines())['populated'] == '0',
+            'Retired HTTP child is foreign or populated')
+    (child/'cgroup.freeze').write_text('0\n'); child.rmdir()
+    return dict(status='retired_empty_HTTP_child_removed_before_game_listener_child')
