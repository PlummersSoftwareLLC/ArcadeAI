      "test_default_PLAN_has_no_source_or_runtime_actions",
      "test_AA_case_exact_namespace_freshness_and_RC_requires_closed_AA",
      "test_dedicated_carrier_and_same_description_fd_forwarding_are_required",
      "test_stop_signals_only_original_handles_and_records_timeout_without_kill",
      "test_fixed_wait_never_retries_failed_member_or_rearms_deadline",
      "test_padding_and_commands_refuse_clock_replay_parent_or_boundary_drift",
      "test_actual_gate_keeps_each_candidate_separate_and_AA_never_qualifies",
      "test_no_gate_on_missing_games_duplicate_ID_padding_or_foreign_provenance"
    ],
